<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"> <!-- Beautiful deep blue-grey Windows 11-like background -->

    <!-- Desktop Wallpaper Backdrop (Fluid Modern Aesthetic) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- Desktop Area / Quick Shortcuts / Desktop Grid -->
    <RelativeLayout
        android:id="@+id/desktop_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/taskbar"
        android:padding="24dp">

        <!-- Central Windows Hero Logo & Welcome Text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Windows 11-like Hero Logo made of simple shapes -->
            <GridLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignBounds"
                android:alpha="0.85">

                <!-- Blue glass squares -->
                <View
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="1dp"
                    android:background="#0078D7" />
                <View
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="1dp"
                    android:background="#0078D7" />
                <View
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="1dp"
                    android:background="#0078D7" />
                <View
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_margin="1dp"
                    android:background="#0078D7" />
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Windows 11"
                android:textColor="#E2E8F0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap the Start menu or icons below to launch applications"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:gravity="center" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Start Menu Panel (Windows 10/11 Split Design) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/start_menu_panel"
        android:layout_width="340dp"
        android:layout_height="480dp"
        android:layout_above="@id/taskbar"
        android:layout_alignParentStart="true"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#CC1E293B" <!-- Translucent Acrylic look -->
        app:cardCornerRadius="12dp"
        app:cardElevation="24dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- LEFT PANEL: Vertical Navigation Rail (Classic Windows Style) -->
            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="#CC0F172A"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- User Profile Icon -->
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/sym_def_app_icon"
                    android:contentDescription="User Profile" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Documents Shortcut -->
                <ImageButton
                    android:id="@+id/btn_nav_docs"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_save"
                    android:contentDescription="Documents"
                    android:tint="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <!-- Settings Shortcut -->
                <ImageButton
                    android:id="@+id/btn_nav_settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_preferences"
                    android:contentDescription="Settings"
                    android:tint="#FFFFFF"
                    android:layout_marginBottom="12dp" />

                <!-- Power / Close Shortcut -->
                <ImageButton
                    android:id="@+id/btn_nav_power"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_lock_power_off"
                    android:contentDescription="Power"
                    android:tint="#EF4444" />
            </LinearLayout>

            <!-- RIGHT PANEL: Search, App List & Actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Modern Fluent Search Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#33FFFFFF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        android:tint="#94A3B8" />

                    <EditText
                        android:id="@+id/search_apps"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="Type here to search..."
                        android:textColorHint="#94A3B8"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Apps"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- App List -->
                <ListView
                    android:id="@+id/apps_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="4dp" />

                <!-- Footer Quick Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start Menu OS v2.0"
                        android:textColor="#475569"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Windows Taskbar -->
    <LinearLayout
        android:id="@+id/taskbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:background="#E60F172A" <!-- Translucent Taskbar -->
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:elevation="12dp">

        <!-- Start Button (With iconic ⊞ Windows Logo) -->
        <Button
            android:id="@+id/btn_menu"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="⊞ Start"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#0078D7"
            android:textColor="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Pinned Apps / Quick Launch (Simulates Windows taskbar pinning) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp">

            <!-- Web Browser Shortcut -->
            <ImageButton
                android:id="@+id/btn_taskbar_browser"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_compass"
                android:contentDescription="Browser"
                android:tint="#38BDF8"
                android:scaleType="fitCenter" />

            <!-- Phone Dialer Shortcut -->
            <ImageButton
                android:id="@+id/btn_taskbar_phone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_call"
                android:contentDescription="Phone"
                android:tint="#4ADE80"
                android:scaleType="fitCenter"
                android:layout_marginStart="8dp" />

            <!-- System Settings Shortcut -->
            <ImageButton
                android:id="@+id/btn_taskbar_settings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_preferences"
                android:contentDescription="Settings"
                android:tint="#94A3B8"
                android:scaleType="fitCenter"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- System Tray Area (Wi-Fi, Vol, Battery, Time) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Mock Status Icons (Wi-Fi, Volume, Battery) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📶 🔊 🔋"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />

            <!-- Clock & Date Stack -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tray_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00 PM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tray_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8/18/2026"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
